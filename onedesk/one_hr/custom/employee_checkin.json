{
 "custom_fields": [
  {
   "dt": "Employee Checkin",
   "fieldname": "one_reason",
   "fieldtype": "Link",
   "label": "Reason",
   "module": "One HR",
   "insert_after": "log_type",
   "options": "Clock Reason",
   "depends_on": "eval:doc.log_type == 'OUT'",
   "in_list_view": 1,
   "description": "Asked on check out only. Options come from Clock Reason."
  },
  {
   "dt": "Employee Checkin",
   "fieldname": "one_auto_closed",
   "fieldtype": "Check",
   "label": "Closed Automatically",
   "module": "One HR",
   "insert_after": "one_reason",
   "default": "0",
   "read_only": 1,
   "depends_on": "eval:doc.one_auto_closed",
   "description": "No one checked out, so this OUT was written at the shift end."
  },
  {
   "dt": "Employee Checkin",
   "fieldname": "one_attempt",
   "fieldtype": "Link",
   "label": "Clock Attempt",
   "module": "One HR",
   "insert_after": "one_auto_closed",
   "options": "Clock Attempt",
   "read_only": 1,
   "description": "What each check saw when this log was written."
  },
  {
   "dt": "Employee Checkin",
   "fieldname": "one_outcome",
   "fieldtype": "Data",
   "label": "Outcome",
   "module": "One HR",
   "insert_after": "one_attempt",
   "read_only": 1,
   "fetch_from": "one_attempt.outcome",
   "fetch_if_empty": 0,
   "in_standard_filter": 1
  },
  {
   "dt": "Employee Checkin",
   "fieldname": "one_score",
   "fieldtype": "Int",
   "label": "Score",
   "module": "One HR",
   "insert_after": "one_outcome",
   "read_only": 1,
   "fetch_from": "one_attempt.score",
   "fetch_if_empty": 0,
   "description": "Out of 100. Below the confirmation threshold the log is flagged for review."
  }
 ],
 "doctype": "Employee Checkin",
 "links": [],
 "property_setters": [
  {
   "doc_type": "Employee Checkin",
   "doctype_or_field": "DocField",
   "field_name": "device_id",
   "property": "hidden",
   "property_type": "Check",
   "value": "1"
  },
  {
   "doc_type": "Employee Checkin",
   "doctype_or_field": "DocField",
   "field_name": "fetch_geolocation",
   "property": "depends_on",
   "property_type": "Data",
   "value": "eval:doc.__islocal"
  }
 ],
 "sync_on_migrate": 1
}
