{
 "custom_fields": [
  {
   "dt": "HR Settings",
   "fieldname": "one_attendance_tab",
   "fieldtype": "Tab Break",
   "label": "Attendance",
   "module": "One HR",
   "insert_after": "allow_geolocation_tracking"
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_self_checkin_section",
   "fieldtype": "Section Break",
   "label": "Self Check-in",
   "module": "One HR",
   "insert_after": "one_attendance_tab"
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_self_checkin",
   "fieldtype": "Check",
   "label": "Allow Employees to Check In Themselves",
   "module": "One HR",
   "insert_after": "one_self_checkin_section",
   "default": "0",
   "description": "Requires a User linked to the Employee record."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_close_the_day",
   "fieldtype": "Check",
   "label": "Auto Close Open Check-ins at Shift End",
   "module": "One HR",
   "insert_after": "one_self_checkin",
   "default": "1",
   "depends_on": "one_self_checkin",
   "description": "An employee who never checks out gets an OUT written at the shift end, marked Closed Automatically."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_reason_on_out",
   "fieldtype": "Check",
   "label": "Ask for a Reason on Check Out",
   "module": "One HR",
   "insert_after": "one_close_the_day",
   "default": "1",
   "depends_on": "one_self_checkin",
   "description": "Options come from Clock Reason."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_gates_section",
   "fieldtype": "Section Break",
   "label": "Verification",
   "module": "One HR",
   "insert_after": "one_reason_on_out",
   "depends_on": "one_self_checkin",
   "description": "Every check-in is scored out of 100 and the score is kept on Clock Attempt. Each check below that fails subtracts from it."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_gate_passkey",
   "fieldtype": "Check",
   "label": "Require a Passkey",
   "module": "One HR",
   "insert_after": "one_gates_section",
   "default": "1",
   "description": "One passkey per employee, registered on their own phone. Replacing it requires an HR reset."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_passkey_refuses",
   "fieldtype": "Check",
   "label": "Refuse Check-in Without a Passkey",
   "module": "One HR",
   "insert_after": "one_gate_passkey",
   "default": "1",
   "depends_on": "one_gate_passkey",
   "description": "If unchecked, a missing passkey is only flagged."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_gate_network",
   "fieldtype": "Check",
   "label": "Check the Network",
   "module": "One HR",
   "insert_after": "one_passkey_refuses",
   "default": "1",
   "description": "Match the address the request came from against Clock Network."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_gate_place",
   "fieldtype": "Check",
   "label": "Check the Location",
   "module": "One HR",
   "insert_after": "one_gate_network",
   "default": "1",
   "description": "Match the position the browser reports against Clock Place and the Shift Location's own radius. Requires Allow Geolocation Tracking."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_column_gates",
   "fieldtype": "Column Break",
   "label": null,
   "module": "One HR",
   "insert_after": "one_gate_place"
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_gates_require",
   "fieldtype": "Select",
   "label": "Network and Location",
   "module": "One HR",
   "insert_after": "one_column_gates",
   "options": "Either\nBoth",
   "default": "Either",
   "description": "Either accepts a check-in that passes one of the two. Both requires each of them."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_refuse_below",
   "fieldtype": "Int",
   "label": "Refuse Below Score",
   "module": "One HR",
   "insert_after": "one_gates_require",
   "default": "50",
   "description": "Check-ins scoring below this are refused and no Employee Checkin is written. The failing checks are shown to the employee."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_flag_below",
   "fieldtype": "Int",
   "label": "Flag Below Score",
   "module": "One HR",
   "insert_after": "one_refuse_below",
   "default": "85",
   "description": "Check-ins scoring between this and Refuse Below Score are written, and marked Flagged for review."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_gate_photo",
   "fieldtype": "Check",
   "label": "Ask for a Photo",
   "module": "One HR",
   "insert_after": "one_flag_below",
   "default": "0",
   "description": "Captures a frame from the camera at check-in. Choosing an existing file instead is not allowed."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_keep_photo_days",
   "fieldtype": "Int",
   "label": "Delete Photos After (Days)",
   "module": "One HR",
   "insert_after": "one_gate_photo",
   "default": "7",
   "depends_on": "one_gate_photo",
   "description": "Set to 0 to keep them indefinitely."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_learning_section",
   "fieldtype": "Section Break",
   "label": "Learning",
   "module": "One HR",
   "insert_after": "one_keep_photo_days",
   "depends_on": "one_self_checkin",
   "description": "Only check-ins that passed another check are counted. Nothing learned widens who may check in."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_learn_networks",
   "fieldtype": "Check",
   "label": "Learn New Networks",
   "module": "One HR",
   "insert_after": "one_learning_section",
   "default": "1",
   "description": "Propose a Clock Network when enough employees check in from an address the site does not know."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_learn_zones",
   "fieldtype": "Check",
   "label": "Learn New Locations",
   "module": "One HR",
   "insert_after": "one_learn_networks",
   "default": "1",
   "description": "Propose a Clock Place when enough employees check in from just outside an existing one."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_column_learning",
   "fieldtype": "Column Break",
   "label": null,
   "module": "One HR",
   "insert_after": "one_learn_zones"
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_learn_home",
   "fieldtype": "Check",
   "label": "Include Personal Networks and Locations",
   "module": "One HR",
   "insert_after": "one_column_learning",
   "default": "0",
   "description": "Also propose networks and locations belonging to a single employee, such as a home."
  },
  {
   "dt": "HR Settings",
   "fieldname": "one_learn_threshold",
   "fieldtype": "Int",
   "label": "Confirmation Threshold",
   "module": "One HR",
   "insert_after": "one_learn_home",
   "default": "3",
   "description": "Number of distinct employees, and of check-ins each, before a Proposed network or location becomes Confirmed."
  }
 ],
 "doctype": "HR Settings",
