msgstr "Ein Arbeitsbereich darf höchstens {0} eigene Domains haben."

#: onedesk/one_admin/doctype/offering/offering.py:33
msgid "A {0} does not carry {1}."
msgstr "Ein {0} trägt kein Feld {1}."

#: onedesk/one_ai/proposals.py:325
msgid "A {0} has to name a record."
msgstr "Ein {0} muss einen Datensatz nennen."

