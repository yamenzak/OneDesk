msgstr "يطلب منك <b>{who}</b> ملفات: <b>{request}</b>{note}{due}<br><br><a href=\"{link}\">أرسلها</a>"

#: onedesk/one_storage/notifications.py:70
msgid "<b>{who}</b> is still waiting for files for <b>{request}</b>.<br><br><a href=\"{link}\">Send them</a>"
msgstr "لا يزال <b>{who}</b> ينتظر ملفات لطلب <b>{request}</b>.<br><br><a href=\"{link}\">أرسلها</a>"

