#: onedesk/one_admin/notifications.py:74
msgid "<a href=\"{link}\">Sign in to your One account</a><br><br>The link works once, for {minutes} minutes. If you didn't ask for it, you can ignore this email."
msgstr "<a href=\"{link}\">سجّل الدخول إلى حسابك في One</a><br><br>يعمل الرابط مرة واحدة، لمدة {minutes} دقيقة. إن لم تطلبه، يمكنك تجاهل هذا البريد."

#: onedesk/one_admin/notifications.py:115
msgid "<a href=\"{link}\">Use this address for my One account</a><br><br>The link works once, for {minutes} minutes. If you didn't ask for this, you can ignore this email."
msgstr "<a href=\"{link}\">استخدم هذا العنوان لحسابي في One</a><br><br>يعمل الرابط مرة واحدة، لمدة {minutes} دقيقة. إن لم تطلب ذلك، يمكنك تجاهل هذا البريد."

#: onedesk/one_calendar/notifications.py:47
msgid "<b>{event}</b> starts at {time}{where}."
msgstr "يبدأ <b>{event}</b> الساعة {time}{where}."

#: onedesk/one_calendar/notifications.py:17
msgid "<b>{event}</b>, {when}{where}."
msgstr "<b>{event}</b>، {when}{where}."

#: onedesk/one/notifications.py:89
msgid "<b>{inviter}</b> invited you to <b>{workspace}</b> on One.{apps}<br><br><a href=\"{link}\">Choose your password</a><br><br>The link works for {days} days. You sign in with {address}."
msgstr "دعاك <b>{inviter}</b> إلى <b>{workspace}</b> على One.{apps}<br><br><a href=\"{link}\">اختر كلمة المرور</a><br><br>يعمل الرابط لمدة {days} أيام. تسجّل الدخول باستخدام {address}."

#: onedesk/one_task/notifications.py:17
msgid "<b>{task}</b>{due}{project}"
msgstr "<b>{task}</b>{due}{project}"

#: onedesk/one_task/notifications.py:27
msgid "<b>{task}</b>{project} is done."
msgstr "اكتملت <b>{task}</b>{project}."

#: onedesk/one_storage/notifications.py:77
msgid "<b>{who}</b> is still waiting for files for <b>{request}</b>.<br><br><a href=\"{link}\">Upload Files</a>"
msgstr "لا يزال <b>{who}</b> بانتظار ملفات لـ <b>{request}</b>.<br><br><a href=\"{link}\">رفع الملفات</a>"

#: onedesk/one_storage/notifications.py:66
msgid "<b>{who}</b> requested files for <b>{request}</b>.{note}{due}<br><br><a href=\"{link}\">Upload Files</a>"
msgstr "طلب <b>{who}</b> ملفات لـ <b>{request}</b>.{note}{due}<br><br><a href=\"{link}\">رفع الملفات</a>"

