#: onedesk/one/workspace/one/one.json
msgid "<span class=\"h4\"><b>One</b></span>"
msgstr "<span class=\"h4\"><b>One</b></span>"

#. Header text in the One Admin Workspace
#: onedesk/one_admin/workspace/one_admin/one_admin.json
msgid "<span class=\"h4\"><b>Right now</b></span>"
msgstr "<span class=\"h4\"><b>الآن</b></span>"

#. Header text in the OneCRM Workspace
#: onedesk/one_crm/workspace/onecrm/onecrm.json
msgid "<span class=\"h4\"><b>The Pipeline</b></span>"
msgstr "<span class=\"h4\"><b>خط المبيعات</b></span>"

#. Header text in the OneHR Workspace
#: onedesk/one_hr/workspace/onehr/onehr.json
msgid "<span class=\"h4\"><b>Today</b></span>"
msgstr "<span class=\"h4\"><b>اليوم</b></span>"

#. Label of the is_person (Check) field in DocType 'Reading Party'
#: onedesk/one_intake/doctype/reading_party/reading_party.json
msgid "A Person"
msgstr "شخص"

#: onedesk/one_hr/heads.py:578
msgid "A Shift Assignment is created and the employee works this shift."
msgstr "يُنشأ تكليف مناوبة ويعمل الموظف هذه المناوبة."

#. Description of the 'Belongs To' (Section Break) field in DocType 'Clock
#. Network'
#. Description of the 'Shift Location' (Link) field in DocType 'Clock Place'
#: onedesk/one_hr/doctype/clock_network/clock_network.json
#: onedesk/one_hr/doctype/clock_place/clock_place.json
msgid "A Shift Location, or a single employee. Leave both empty to apply it site-wide."
msgstr "موقع مناوبة، أو موظف واحد. اترك الحقلين فارغين لتطبيقه على الموقع بأكمله."

#: onedesk/one_book/ready.py:175
msgid "A UAE tax invoice must show the supplier's TRN."
msgstr "يجب أن تُظهر الفاتورة الضريبية في الإمارات الرقم الضريبي للمورد."

#: onedesk/one_storage/doctype/cloud_mount/cloud_mount.py:16
msgid "A WebDAV address starts with https://."
msgstr "يبدأ عنوان WebDAV بـ https://."

#: onedesk/one_book/ready.py:111 onedesk/one_book/ready.py:112
msgid "A bank account is set up"
msgstr "تم إعداد حساب بنكي"

#: onedesk/one/push.py:126 onedesk/public/js/push.js:45
msgid "A browser"
msgstr "متصفح"

#. Description of the 'Kind' (Select) field in DocType 'AI Model Rate'
#: onedesk/one_admin/doctype/ai_model_rate/ai_model_rate.json
msgid "A cache read is a third thing, not a cheaper input."
msgstr "قراءة المخزن المؤقت شيء ثالث، وليست مدخلاً أرخص."

#: onedesk/one_crm/record.py:171
msgid "A call is Outgoing or Incoming, and Answered, No Answer or Busy."
msgstr "المكالمة إما صادرة أو واردة، وإما تم الرد عليها أو لم يُرد عليها أو كان الخط مشغولاً."

#: onedesk/one_crm/notifications.py:13
msgid "A campaign's mails to its leads or contacts, on its schedule, in the templates it names."
msgstr "رسائل الحملة إلى عملائها المحتملين أو جهات اتصالها، وفق جدولها، وبالقوالب التي تحددها."

#. Description of the 'Held' (Float) field in DocType 'Credit Reservation'
#: onedesk/one_admin/doctype/credit_reservation/credit_reservation.json
msgid "A ceiling, not a forecast. The rest is released on settling."
msgstr "سقف لا تقدير. ويُفرج عن الباقي عند التسوية."

#. Description of the 'Chart' (Data) field in DocType 'Record Head Chart'
#: onedesk/one/doctype/record_head_chart/record_head_chart.json
msgid "A chart a module registered by name. It works out its own figures, as the reader."
msgstr "مخطط سجّلته وحدة باسمه. يحسب أرقامه بنفسه، بصلاحيات القارئ."

#. Description of the 'Treat as a Site' (Check) field in DocType 'Shift
#. Location'
#: onedesk/one_hr/custom/shift_location.json
msgid "A check-in from outside the radius is allowed, and the distance is recorded on Clock Attempt. If unchecked, it is refused."
msgstr "يُسمح بتسجيل الحضور من خارج نطاق النصف القطري، وتُسجَّل المسافة في محاولة التسجيل. إذا لم يتم تحديده، يُرفض."

#: onedesk/one_hr/notifications.py:45
msgid "A check-in looked wrong, and waits for somebody to accept or reject it. Sent to its reviewers."
msgstr "بدا تسجيل حضور غير صحيح، وينتظر من يقبله أو يرفضه. يُرسل إلى مراجعيه."

#: onedesk/public/js/intake.js:203
msgid "A copy of {0}"
msgstr "نسخة من {0}"

#: onedesk/one_admin/doctype/offering/offering.py:39
msgid "A credit pack is bought once, so it does not recur."
msgstr "تُشترى حزمة الرصيد مرة واحدة، فهي لا تتكرر."

#: onedesk/one_admin/doctype/offering/offering.py:41
msgid "A credit pack with no credits in it sells nothing."
msgstr "حزمة رصيد بلا رصيد فيها لا تبيع شيئاً."

#. Description of a DocType
#: onedesk/one_admin/doctype/tenant_domain/tenant_domain.json
msgid "A custom domain on a workspace. Created when the workspace requests one."
msgstr "نطاق مخصّص على مساحة عمل. يُنشأ حين تطلبه مساحة العمل."

#: onedesk/one_book/ready.py:157
msgid "A customer is mailed the invoice a week after it falls due."
msgstr "تُرسل الفاتورة إلى العميل بعد أسبوع من استحقاقها."

#. Description of a DocType
#: onedesk/one_admin/doctype/tenant/tenant.json
msgid "A customer workspace. Created from a paid Account Request."
msgstr "مساحة عمل لعميل. تُنشأ من طلب حساب مدفوع."

#. Description of a DocType
#: onedesk/one_intake/doctype/reading_date/reading_date.json
msgid "A date a document gives, and what it is for."
msgstr "تاريخ يذكره مستند، وما الغرض منه."

#. Description of the 'Probability (%)' (Percent) field in DocType 'Sales
#. Stage'
#: onedesk/one_crm/custom/sales_stage.json
msgid "A deal moved to this stage takes this probability, unless one was typed."
msgstr "تأخذ الصفقة المنقولة إلى هذه المرحلة هذا الاحتمال، ما لم يُكتب احتمال آخر."

#: onedesk/one_intake/planning.py:130
msgid "A document arrived"
msgstr "وصل مستند"

#: onedesk/one_intake/notifications.py:39
msgid "A document arrived for a task you had already closed. The task stays closed."
msgstr "وصل مستند لمهمة كنت قد أغلقتها. تبقى المهمة مغلقة."

#: onedesk/one_intake/planning.py:131
msgid "A document arrived for {0}"
msgstr "وصل مستند لـ {0}"

#. Description of the 'Expires On' (Date) field in DocType 'Employee Document'
#: onedesk/one_hr/doctype/employee_document/employee_document.json
msgid "A document that does not expire, such as a birth certificate, leaves this empty."
msgstr "الوثيقة التي لا تنتهي صلاحيتها، مثل شهادة الميلاد، تُترك فارغة هنا."

#: onedesk/one_storage/dav.py:296
msgid "A drive"
msgstr "محرك أقراص"

#. Description of a DocType
#: onedesk/one_ai/doctype/ai_memory/ai_memory.json
msgid "A fact somebody asked OneAI to keep. Theirs alone, like their conversations."
msgstr "معلومة طلب أحدهم من OneAI الاحتفاظ بها. تخصّه وحده، مثل محادثاته."

#. Description of a DocType
#: onedesk/one_ai/doctype/ai_touch/ai_touch.json
msgid "A field OneAI wrote, and what it wrote. The badge shows while the field still says it."
msgstr "حقل كتبه OneAI وما كتبه. تظهر الشارة ما دام الحقل يقول ذلك."

#. Description of the 'Field' (Data) field in DocType 'Record Head Band'
#: onedesk/one/doctype/record_head_band/record_head_band.json
msgid "A field of the record, of the record it links to, or the one summed."
msgstr "حقل من السجل، أو من السجل المرتبط به، أو الحقل الذي يُجمع."

#. Description of the 'In the Tab Of' (Data) field in DocType 'Record Head
#. Linked'
#: onedesk/one/doctype/record_head_linked/record_head_linked.json
msgid "A field of this record. The section goes at the end of its tab, or of the first tab when empty."
msgstr "حقل من هذا السجل. يأتي القسم في آخر تبويبه، أو في آخر التبويب الأول إن تُرك فارغًا."

#. Description of a DocType
#: onedesk/one_intake/doctype/file_link/file_link.json
msgid "A file that belongs to a record as well as to where it is kept."
msgstr "ملف يخص سجلًا إضافة إلى المكان المحفوظ فيه."

#: onedesk/public/js/onecloud.js:2013
msgid "A file with this name is already here"
msgstr "يوجد هنا بالفعل ملف بهذا الاسم"

#: onedesk/one_storage/api.py:221 onedesk/one_storage/api.py:336
msgid "A folder cannot go inside itself."
msgstr "لا يمكن وضع مجلد داخل نفسه."

#: onedesk/one_mail/actions.py:292
msgid "A folder needs a name of up to 100 characters."
msgstr "يحتاج المجلد إلى اسم لا يتجاوز 100 حرف."

#. Description of the 'Team Library' (Check) field in DocType 'File'
#: onedesk/one_storage/custom/file.json
msgid "A folder people are members of, the way a team's document library is."
msgstr "مجلد يكون الأشخاص أعضاء فيه، كمكتبة مستندات الفريق."

#. Description of the 'Not Shown' (Check) field in DocType 'Mail Folder'
#: onedesk/one_mail/doctype/mail_folder/mail_folder.json
msgid "A folder that only repeats others, such as Gmail's All Mail, or one that holds no mail itself."
msgstr "مجلد يكرر مجلدات أخرى فقط، مثل «كل البريد» في Gmail، أو مجلد لا يحتوي على بريد بنفسه."

#: onedesk/one_mail/actions.py:302
msgid "A folder's name cannot hold {0}."
msgstr "لا يمكن أن يحتوي اسم المجلد على {0}."

#. Description of the 'Kind' (Select) field in DocType 'Credit Ledger Entry'
#: onedesk/one_admin/doctype/credit_ledger_entry/credit_ledger_entry.json
msgid "A grant adds and may expire. A spend and a refund are always against one."
msgstr "المنحة تضيف وقد تنتهي. أما الإنفاق والاسترداد فيكونان دائماً مقابل منحة."

#: onedesk/one_admin/doctype/credit_ledger_entry/credit_ledger_entry.py:43
msgid "A grant is not drawn from anything."
msgstr "المنحة لا تُسحب من شيء."

#. Description of the 'Household' (Check) field in DocType 'Intake Settings'
#: onedesk/one_intake/doctype/intake_settings/intake_settings.json
msgid "A household keeps no books. No drafts are made, and Spending shows what was bought."
msgstr "الأسرة لا تمسك دفاتر. لا تُنشأ مسودات، ويعرض الإنفاق ما اشتُري."

#: onedesk/one_intake/notifications.py:46
msgid "A known supplier's document asks to be paid to an IBAN we do not have for them."
msgstr "مستند من مورد معروف يطلب الدفع إلى رقم IBAN غير مسجل لدينا له."

#: onedesk/one_book/ready.py:155
msgid "A late customer is reminded"
msgstr "يُذكَّر العميل المتأخر"

#: onedesk/one_crm/capture.py:128
msgid "A lead cannot be merged into itself."
msgstr "لا يمكن دمج العميل المحتمل في نفسه."

#: onedesk/one_hr/notifications.py:122
msgid "A leave application was approved, rejected or cancelled. Sent to the employee."
msgstr "تمت الموافقة على طلب إجازة أو رفضه أو إلغاؤه. يُرسل إلى الموظف."

#: onedesk/one_admin/doctype/credit_ledger_entry/credit_ledger_entry.py:31
msgid "A ledger entry of zero credits records nothing."
msgstr "قيد بصفر رصيد لا يسجّل شيئاً."

#: onedesk/one_storage/library.py:45
msgid "A library needs a name."
msgstr "تحتاج المكتبة إلى اسم."

#. Description of a DocType
#: onedesk/one_intake/doctype/reading_line/reading_line.json
msgid "A line of an invoice or a receipt."
msgstr "بند من فاتورة أو إيصال."

#. Description of a DocType
#: onedesk/one_storage/doctype/cloud_link/cloud_link.json
msgid "A link to a file or folder in OneCloud for people outside the team."
msgstr "رابط إلى ملف أو مجلد في OneCloud لأشخاص من خارج الفريق."

#: onedesk/one/settings.py:114
msgid "A mail before an event of yours starts."
msgstr "بريد قبل أن يبدأ حدث لك."

#: onedesk/public/js/onemail.js:786
msgid "A mailbox such as sales@ that belongs to the workspace. You choose who holds it."
msgstr "صندوق بريد مثل sales@ يخص مساحة العمل. أنت تختار من يحمله."

#: onedesk/one_mail/notifications.py:10
msgid "A mailbox you hold stopped connecting. Sent once, when it breaks, to everybody who holds it."
msgstr "صندوق بريد تحمله توقف عن الاتصال. يُرسل مرة واحدة عند تعطله إلى كل من يحمله."

#. Description of the 'Sent by a Machine' (Check) field in DocType 'Reading'
#: onedesk/one_intake/doctype/reading/reading.json
msgid "A mailing list, a bulk send or an automatic reply."
msgstr "قائمة بريدية أو إرسال جماعي أو رد آلي."

#: onedesk/one_admin/doctype/ai_model/ai_model.py:60
msgid "A markup below nothing would pay somebody to call the model."
msgstr "هامش دون الصفر يعني الدفع لمن يستدعي النموذج."

#. Description of the 'Measure' (Data) field in DocType 'Record Head Band'
#: onedesk/one/doctype/record_head_band/record_head_band.json
msgid "A measure a module registered by name. It may say its own label, tone and link."
msgstr "مقياس سجّلته وحدة باسمه. قد يحدد عنوانه ونبرته ورابطه بنفسه."

#. Description of the 'Measure' (Data) field in DocType 'Record Head Indicator'
#: onedesk/one/doctype/record_head_indicator/record_head_indicator.json
msgid "A measure a module registered that says the pill itself, as a label and a colour. Nothing said is no pill."
msgstr "مقياس سجّلته وحدة يحدّد الشارة بنفسه، بتسمية ولون. إن لم يقل شيئًا فلا شارة."

#. Description of the 'Measure' (Data) field in DocType 'Record Head Sentence'
#: onedesk/one/doctype/record_head_sentence/record_head_sentence.json
msgid "A measure a module registered that says the sentence itself, as a text and a colour. Nothing said is no sentence."
msgstr "مقياس سجّلته وحدة يقول الجملة نفسها، نصًا ولونًا. إن لم يقل شيئًا فلا جملة."

#: onedesk/one_storage/library.py:101
msgid "A member is a Reader, a Member or an Owner."
msgstr "العضو إما قارئ أو عضو أو مالك."

#: onedesk/one_mail/actions.py:195
msgid "A message can only move to a folder of its own mailbox."
msgstr "لا يمكن نقل الرسالة إلا إلى مجلد في صندوق بريدها."

#: onedesk/one_mail/actions.py:79
msgid "A message that belongs to no mailbox cannot be changed here."
msgstr "لا يمكن تغيير رسالة لا تنتمي إلى أي صندوق بريد هنا."

#: onedesk/one_mail/linking.py:385
msgid "A message that belongs to no mailbox cannot be filed here."
msgstr "لا يمكن حفظ رسالة لا تنتمي إلى أي صندوق بريد هنا."

#. Description of a DocType
#: onedesk/one_admin/doctype/ai_model/ai_model.json
msgid "A model a provider offers, with the prices it publishes for it."
msgstr "نموذج يعرضه مزوّد، ومعه الأسعار التي ينشرها له."

#: onedesk/one_admin/doctype/ai_model/ai_model.py:29
msgid "A model priced by hand needs at least one rate on it."
msgstr "النموذج المُسعَّر يدوياً يحتاج سعراً واحداً على الأقل."

#. Description of the 'Needs' (Select) field in DocType 'AI Action'
#: onedesk/one_ai/doctype/ai_action/ai_action.json
msgid "A model that can do more than this may still answer it."
msgstr "النموذج الذي يستطيع أكثر من هذا قد يجيبه أيضاً."

#: onedesk/one_hr/doctype/clock_network/clock_network.py:24
msgid "A network belongs to a Shift Location or to one employee, not to both."
msgstr "تنتمي الشبكة إلى موقع مناوبة أو إلى موظف واحد، لا إلى كليهما."

#: onedesk/one_hr/notifications.py:104
msgid "A new check-in network or location was proposed"
msgstr "تم اقتراح شبكة أو موقع جديد لتسجيل الحضور"

#: onedesk/one/customize.py:324 onedesk/one/customize.py:399
msgid "A new field needs a label."
msgstr "يحتاج الحقل الجديد إلى عنوان."

#. Description of the 'Message' (Small Text) field in DocType 'Cloud File
#. Request'
#: onedesk/one_storage/doctype/cloud_file_request/cloud_file_request.json
msgid "A note to the people asked."
msgstr "ملاحظة للأشخاص المطلوب منهم."

#. Description of a DocType
#: onedesk/one_intake/doctype/reading_reference/reading_reference.json
msgid "A number a document refers to: an invoice, an order, a case."
msgstr "رقم يشير إليه مستند: فاتورة أو طلب أو قضية."

#. Description of a DocType
#: onedesk/one_storage/doctype/cloud_drive_password/cloud_drive_password.json
msgid "A password that opens a person's OneCloud drive and nothing else."
msgstr "كلمة مرور تفتح محرك OneCloud الخاص بشخص ولا شيء غيره."

#. Description of a DocType
#: onedesk/one_calendar/doctype/calendar_feed/calendar_feed.json
msgid "A person's calendar link, which other calendar apps read."
msgstr "رابط تقويم شخص، تقرؤه تطبيقات التقويم الأخرى."

#. Description of a DocType
#: onedesk/one_mail/doctype/face/face.json
msgid "A person's picture or an organisation's logo, looked for once and kept in Company › Logos."
msgstr "صورة شخص أو شعار جهة، يُبحث عنها مرة واحدة وتُحفظ في الشركة › الشعارات."

#: onedesk/one_hr/doctype/clock_place/clock_place.py:14
msgid "A place belongs to a Shift Location or to one employee, not to both."
msgstr "ينتمي الموقع إلى موقع مناوبة أو إلى موظف واحد، لا إلى كليهما."

#: onedesk/public/js/customize.js:161
msgid "A place in the desk to open from this record, as a route."
msgstr "مكان في المكتب يُفتح من هذا السجل، كمسار."

#: onedesk/public/js/settings.js:329
msgid "A private link that shows your events, tasks and deadlines in Google Calendar, Outlook or on a phone."
msgstr "رابط خاص يعرض أحداثك ومهامك ومواعيدك النهائية في تقويم Google أو Outlook أو على الهاتف."

#: onedesk/one_project/notifications.py:11
msgid "A project asks its people how it is going, as often as the project says. A project's own question is asked instead of this text."
msgstr "يسأل المشروع أفراده عن سير العمل، بالوتيرة التي يحددها المشروع. ويُطرح سؤال المشروع الخاص بدلاً من هذا النص."

#. Description of a DocType
#: onedesk/one_admin/doctype/provisioning_job/provisioning_job.json
msgid "A queued unit of work against a workspace. Created by the system."
msgstr "وحدة عمل في طابور التنفيذ على مساحة عمل. يُنشئها النظام."

#: onedesk/one_admin/doctype/ai_model/ai_model.py:64
msgid "A rate needs a unit, how many of them, and what they cost."
msgstr "يحتاج السعر إلى وحدة، وعددها، وكلفتها."

#: onedesk/one_intake/identity.py:307
msgid "A record cannot be merged into itself."
