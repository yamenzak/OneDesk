msgstr "أُرشفت {workspace}"

#. Subject of a notification
#: onedesk/notifications/one_admin/workspace_closed.md
msgid "{workspace} is closed"
msgstr "أُغلقت {workspace}"

#. Message of a notification
#: onedesk/notifications/one_admin/workspace_closed.md
msgid "{workspace} is closed, as you asked, and its subscription is cancelled. A backup is kept, and your files are still there.<br><br>On {date} the workspace and its files will be permanently deleted. To get it back before then, reply to this email."
msgstr "أُغلقت {workspace} كما طلبت، وأُلغي اشتراكها. نحتفظ بنسخة احتياطية، وملفاتك لا تزال موجودة.<br><br>في {date} ستُحذف مساحة العمل وملفاتها نهائيًا. لاستعادتها قبل ذلك، ردّ على هذا البريد."

#. Subject of a notification
#: onedesk/notifications/one_admin/workspace_delayed.md
msgid "{workspace} is delayed"
msgstr "تأخّرت {workspace}"

#. Subject of a notification
#: onedesk/notifications/one_admin/workspace_moved_to_you.md
msgid "{workspace} is now in your One account"
msgstr "أصبحت {workspace} في حسابك في One"

#. Subject of a notification
#: onedesk/notifications/one_admin/workspace_restored.md
msgid "{workspace} is open again"
msgstr "{workspace} مفتوحة من جديد"

#. Subject of a notification
#: onedesk/notifications/one_admin/workspace_ready.md
msgid "{workspace} is ready"
msgstr "{workspace} جاهزة"

#. Message of a notification
#: onedesk/notifications/one_admin/workspace_ready.md
msgid "{workspace} is ready at {address}.<br><br>A second email has a link to choose your password. It works for 7 days. If it hasn't arrived, reply to this email. The workspace is also in your One account, with your other workspaces."
msgstr "{workspace} جاهزة على {address}.<br><br>في رسالة ثانية رابط لاختيار كلمة المرور، يعمل لمدة 7 أيام. إن لم تصل، فردّ على هذه الرسالة. مساحة العمل موجودة أيضًا في حسابك في One مع مساحات عملك الأخرى."

#. Subject of a notification
#: onedesk/notifications/one_admin/workspace_suspended.md
msgid "{workspace} is suspended"
msgstr "عُلّقت {workspace}"

#. Subject of a notification
#: onedesk/notifications/one_admin/finish_signing_up.md
msgid "{workspace} is waiting for you"
msgstr "{workspace} بانتظارك"

#. Subject of a notification
#: onedesk/notifications/one_admin/signup_not_built.md
msgid "{workspace} paid and has no workspace"
msgstr "دفع {workspace} وليس لديه مساحة عمل"

#. Subject of a notification
#: onedesk/notifications/one_admin/paid_while_archived.md
msgid "{workspace} paid while {state}"
msgstr "دفعت {workspace} وهي في حالة {state}"

#. Subject of a notification
#: onedesk/notifications/one_admin/new_signup.md
msgid "{workspace} signed up"
msgstr "اشترك {workspace}"

#. Message of a notification
#: onedesk/notifications/one_admin/workspace_archived.md
msgid "{workspace} was suspended and not paid for, so it has been taken offline. A backup is kept, and your files are still there.<br><br>On {date} the workspace and its files will be permanently deleted. To restore it before then, pay the invoice we sent you and reply to this email."
msgstr "أُوقفت {workspace} ولم تُدفع، لذا أصبحت غير متصلة. نحتفظ بنسخة احتياطية، وملفاتك لا تزال موجودة.<br><br>في {date} ستُحذف مساحة العمل وملفاتها نهائيًا. لاستعادتها قبل ذلك، ادفع الفاتورة التي أرسلناها إليك وردّ على هذا البريد."

#. Subject of a notification
#: onedesk/notifications/one_admin/workspace_owing.md
msgid "{workspace}: {state}"
msgstr "{workspace}: {state}"

