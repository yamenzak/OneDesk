#: onedesk/one_hr/heads.py:578
msgid "A Shift Assignment is created and the employee works this shift."
msgstr "يُنشأ تكليف مناوبة ويعمل الموظف هذه المناوبة."

#. Description of the 'Belongs To' (Section Break) field in DocType 'Clock
#. Network'
#. Description of the 'Shift Location' (Link) field in DocType 'Clock Place'
#: onedesk/one_hr/doctype/clock_network/clock_network.json
#: onedesk/one_hr/doctype/clock_place/clock_place.json
msgid "A Shift Location, or a single employee. Leave both empty to apply it site-wide."
msgstr "موقع مناوبة، أو موظف واحد. اترك الحقلين فارغين لتطبيقه على الموقع بأكمله."

#: onedesk/one_book/ready.py:175
msgid "A UAE tax invoice must show the supplier's TRN."
msgstr "يجب أن تُظهر الفاتورة الضريبية في الإمارات الرقم الضريبي للمورد."

#: onedesk/one_book/ready.py:111 onedesk/one_book/ready.py:112
msgid "A bank account is set up"
msgstr "تم إعداد حساب بنكي"

#: onedesk/one/push.py:126 onedesk/public/js/push.js:45
msgid "A browser"
msgstr "متصفح"

#. Description of the 'Kind' (Select) field in DocType 'AI Model Rate'
#: onedesk/one_admin/doctype/ai_model_rate/ai_model_rate.json
msgid "A cache read is a third thing, not a cheaper input."
msgstr "قراءة المخزن المؤقت شيء ثالث، وليست مدخلاً أرخص."

#: onedesk/one_crm/record.py:171
msgid "A call is Outgoing or Incoming, and Answered, No Answer or Busy."
msgstr "المكالمة إما صادرة أو واردة، وإما تم الرد عليها أو لم يُرد عليها أو كان الخط مشغولاً."

#. Description of the 'Held' (Float) field in DocType 'Credit Reservation'
#: onedesk/one_admin/doctype/credit_reservation/credit_reservation.json
msgid "A ceiling, not a forecast. The rest is released on settling."
msgstr "سقف لا تقدير. ويُفرج عن الباقي عند التسوية."

#. Description of the 'Chart' (Data) field in DocType 'Record Head Chart'
#: onedesk/one/doctype/record_head_chart/record_head_chart.json
msgid "A chart a module registered by name. It works out its own figures, as the reader."
msgstr "مخطط سجّلته وحدة باسمه. يحسب أرقامه بنفسه، بصلاحيات القارئ."

#: onedesk/one/reports.py:88
msgid "A chart or a card here counts records, or reads a report."
msgstr "المخطط أو البطاقة هنا تعدّ السجلات أو تقرأ تقريرًا."

#. Description of the 'Treat as a Site' (Check) field in DocType 'Shift
#. Location'
#: onedesk/one_hr/custom/shift_location.json
msgid "A check-in from outside the radius is allowed, and the distance is recorded on Clock Attempt. If unchecked, it is refused."
msgstr "يُسمح بتسجيل الحضور من خارج نطاق النصف القطري، وتُسجَّل المسافة في محاولة التسجيل. إذا لم يتم تحديده، يُرفض."

#: onedesk/one/settings.py:914
msgid "A code after the password. Each person sets it up the next time they sign in."
msgstr "رمز بعد كلمة المرور. يُعدّه كل شخص في المرة القادمة التي يسجّل فيها الدخول."

#: onedesk/one_studio/record_types.py:120
msgid "A collection can't have a {0} field."
msgstr "لا يمكن أن تحتوي المجموعة على حقل {0}."

#: onedesk/one_studio/record_types.py:106
msgid "A collection has at most {0} fields."
msgstr "تحتوي المجموعة على {0} حقلًا كحد أقصى."

#: onedesk/one_studio/record_types.py:104
msgid "A collection needs at least one field."
msgstr "تحتاج المجموعة إلى حقل واحد على الأقل."

#: onedesk/one_studio/record_types.py:100
msgid "A collection's name is 3 to 60 letters, numbers and spaces."
msgstr "اسم المجموعة من 3 إلى 60 حرفًا ورقمًا ومسافة."

#: onedesk/one_studio/places.py:41
msgid "A conversation is opened in OneMail's reading pane."
msgstr "تُفتح محادثة في جزء القراءة في OneMail."

#: onedesk/www/your_data.html:31
msgid "A copy of what it holds about me"
msgstr "نسخة مما تحتفظ به عني"

#: onedesk/public/js/intake.js:203
msgid "A copy of {0}"
msgstr "نسخة من {0}"

#: onedesk/one_admin/doctype/offering/offering.py:53
msgid "A credit pack can't be recurring."
msgstr "لا يمكن أن تكون حزمة الأرصدة متكررة."

#: onedesk/one_admin/doctype/offering/offering.py:55
msgid "A credit pack needs credits."
msgstr "تحتاج حزمة الأرصدة إلى أرصدة."

#: onedesk/one_admin/heads.py:336
msgid "A credit pack they bought."
msgstr "حزمة رصيد اشتروها."

#. Description of a DocType
#: onedesk/one_admin/doctype/tenant_domain/tenant_domain.json
msgid "A custom domain on a workspace. Created when the workspace requests one."
msgstr "نطاق مخصّص على مساحة عمل. يُنشأ حين تطلبه مساحة العمل."

#: onedesk/one_book/ready.py:157
msgid "A customer is mailed the invoice a week after it falls due."
msgstr "تُرسل الفاتورة إلى العميل بعد أسبوع من استحقاقها."

#. Description of a DocType
#: onedesk/one_admin/doctype/tenant/tenant.json
msgid "A customer workspace. Created from a paid Account Request."
msgstr "مساحة عمل لعميل. تُنشأ من طلب حساب مدفوع."

#. Description of a DocType
#: onedesk/one_intake/doctype/reading_date/reading_date.json
msgid "A date a document gives, and what it is for."
msgstr "تاريخ يذكره مستند، وما الغرض منه."

#. Description of the 'Probability (%)' (Percent) field in DocType 'Sales
#. Stage'
#: onedesk/one_crm/custom/sales_stage.json
msgid "A deal moved to this stage takes this probability, unless one was typed."
msgstr "تأخذ الصفقة المنقولة إلى هذه المرحلة هذا الاحتمال، ما لم يُكتب احتمال آخر."

#: onedesk/one_intake/planning.py:130
msgid "A document arrived"
msgstr "وصل مستند"

#: onedesk/one_intake/planning.py:131
msgid "A document arrived for {0}"
msgstr "وصل مستند لـ {0}"

#: onedesk/one_studio/places.py:101
msgid "A document is opened in OneIntake's inbox."
msgstr "يُفتح مستند في صندوق OneIntake."

#. Description of the 'Expires On' (Date) field in DocType 'Employee Document'
#: onedesk/one_hr/doctype/employee_document/employee_document.json
msgid "A document that does not expire, such as a birth certificate, leaves this empty."
msgstr "الوثيقة التي لا تنتهي صلاحيتها، مثل شهادة الميلاد، تُترك فارغة هنا."

#: onedesk/one_admin/hosts.py:96
msgid "A domain is at most {0} characters."
msgstr "النطاق لا يتجاوز {0} حرفًا."

#: onedesk/one_storage/dav.py:296
msgid "A drive"
msgstr "محرك أقراص"

#. Description of a DocType
#: onedesk/one_ai/doctype/ai_memory/ai_memory.json
msgid "A fact somebody asked OneAI to keep. Theirs alone, like their conversations."
msgstr "معلومة طلب أحدهم من OneAI الاحتفاظ بها. تخصّه وحده، مثل محادثاته."

#. Description of a DocType
#: onedesk/one_ai/doctype/ai_touch/ai_touch.json
msgid "A field OneAI wrote, and what it wrote. The badge shows while the field still says it."
msgstr "حقل كتبه OneAI وما كتبه. تظهر الشارة ما دام الحقل يقول ذلك."

#. Description of the 'Field' (Data) field in DocType 'Record Head Band'
#: onedesk/one/doctype/record_head_band/record_head_band.json
msgid "A field of the record, of the record it links to, or the one summed."
msgstr "حقل من السجل، أو من السجل المرتبط به، أو الحقل الذي يُجمع."

#. Description of the 'In the Tab Of' (Data) field in DocType 'Record Head
#. Linked'
#: onedesk/one/doctype/record_head_linked/record_head_linked.json
msgid "A field of this record. The section goes at the end of its tab, or of the first tab when empty."
msgstr "حقل من هذا السجل. يأتي القسم في آخر تبويبه، أو في آخر التبويب الأول إن تُرك فارغًا."

#: onedesk/one_studio/record_types.py:114
msgid "A field says only its label, kind, choices, whether it is required and whether it is in the list."
msgstr "يذكر الحقل فقط تسميته ونوعه وخياراته وما إذا كان مطلوباً وما إذا كان في القائمة."

#: onedesk/one_studio/places.py:87
msgid "A file is chosen in OneCloud and its preview is shown."
msgstr "يُختار ملف في OneCloud وتظهر معاينته."

#. Description of a DocType
#: onedesk/one_intake/doctype/file_link/file_link.json
msgid "A file that belongs to a record as well as to where it is kept."
msgstr "ملف يخص سجلًا إضافة إلى المكان المحفوظ فيه."

#: onedesk/public/js/onecloud.js:2143
msgid "A file with this name is already here"
msgstr "يوجد هنا بالفعل ملف بهذا الاسم"

#: onedesk/one_storage/api.py:221 onedesk/one_storage/api.py:336
msgid "A folder can't be moved into itself."
msgstr "لا يمكن نقل مجلد إلى داخله."

#: onedesk/one_mail/actions.py:313
msgid "A folder named {0} already exists."
msgstr "يوجد مجلد باسم {0} بالفعل."

#. Description of the 'Team Library' (Check) field in DocType 'File'
#: onedesk/one_storage/custom/file.json
msgid "A folder people are members of, the way a team's document library is."
msgstr "مجلد يكون الأشخاص أعضاء فيه، كمكتبة مستندات الفريق."

#. Description of the 'Not Shown' (Check) field in DocType 'Mail Folder'
#: onedesk/one_mail/doctype/mail_folder/mail_folder.json
msgid "A folder that only repeats others, such as Gmail's All Mail, or one that holds no mail itself."
msgstr "مجلد يكرر مجلدات أخرى فقط، مثل «كل البريد» في Gmail، أو مجلد لا يحتوي على بريد بنفسه."

#: onedesk/one/printing.py:624
msgid "A font is a Google Font's name, such as Playfair Display."
msgstr "الخط هو اسم خط من Google Fonts، مثل Playfair Display."

#. Description of the 'Kind' (Select) field in DocType 'Credit Ledger Entry'
#: onedesk/one_admin/doctype/credit_ledger_entry/credit_ledger_entry.json
msgid "A grant adds and may expire. A spend and a refund are always against one."
msgstr "المنحة تضيف وقد تنتهي. أما الإنفاق والاسترداد فيكونان دائماً مقابل منحة."

#: onedesk/one_admin/doctype/credit_ledger_entry/credit_ledger_entry.py:43
msgid "A grant can't be drawn from another entry."
msgstr "لا يمكن خصم منحة من قيد آخر."

#: onedesk/one/access.py:769
msgid "A group holds people of the workspace."
msgstr "تضم المجموعة أشخاصًا من مساحة العمل."

#. Description of the 'Household' (Check) field in DocType 'Intake Settings'
#: onedesk/one_intake/doctype/intake_settings/intake_settings.json
msgid "A household keeps no books. No drafts are made, and Spending shows what was bought."
msgstr "الأسرة لا تمسك دفاتر. لا تُنشأ مسودات، ويعرض الإنفاق ما اشتُري."

#: onedesk/one_admin/doctype/provisioning_job/provisioning_job.py:22
msgid "A job needs a workspace."
msgstr "تحتاج المهمة إلى مساحة عمل."

#: onedesk/one_book/ready.py:155
msgid "A late customer is reminded"
msgstr "يُذكَّر العميل المتأخر"

#: onedesk/one/printing.py:566 onedesk/one/printing.py:656
#: onedesk/one/printing.py:659
msgid "A layout has sections, each of columns of blocks."
msgstr "يتكوّن التخطيط من أقسام، كل منها أعمدة من الكتل."

#: onedesk/one_crm/capture.py:128
msgid "A lead cannot be merged into itself."
msgstr "لا يمكن دمج العميل المحتمل في نفسه."

#: onedesk/one/printing.py:337
msgid "A letter head may not run a script."
msgstr "لا يجوز أن تشغّل ترويسة الرسائل نصًا برمجيًا."

#: onedesk/one/printing.py:347
msgid "A letter head needs its image, uploaded here."
msgstr "تحتاج ترويسة الرسائل إلى صورتها، مرفوعة هنا."

#: onedesk/one/printing.py:352
msgid "A letter head's footer is an image uploaded here."
msgstr "تذييل ترويسة الرسائل صورة مرفوعة هنا."

#: onedesk/one/printing.py:362
msgid "A letter head's header and footer are each a picture or HTML."
msgstr "ترويسة الرسالة وتذييلها كلٌّ منهما صورة أو HTML."

#: onedesk/one/printing.py:345
msgid "A letter head's header needs something to print."
msgstr "ترويسة الرسالة تحتاج إلى شيء لطباعته."

#: onedesk/one/printing.py:341
msgid "A letter head's name may not contain quotes or angle brackets."
msgstr "لا يجوز أن يحتوي اسم ترويسة الرسائل على علامات اقتباس أو أقواس زاوية."

#: onedesk/one/access.py:312 onedesk/one/access.py:443
msgid "A level's name cannot have a colon in it."
msgstr "لا يمكن أن يحتوي اسم المستوى على نقطتين."

#: onedesk/one_storage/library.py:45
msgid "A library needs a name."
msgstr "تحتاج المكتبة إلى اسم."

#: onedesk/public/js/settings.js:2279
msgid "A line in the Brand Colour over the footer."
msgstr "خط بلون العلامة التجارية أعلى التذييل."

#: onedesk/public/js/settings.js:2259
msgid "A line in the Brand Colour under the header."
msgstr "خط بلون العلامة التجارية أسفل الترويسة."

#. Description of a DocType
#: onedesk/one_intake/doctype/reading_line/reading_line.json
msgid "A line of an invoice or a receipt."
msgstr "بند من فاتورة أو إيصال."

#. Description of a DocType
#: onedesk/one_storage/doctype/cloud_link/cloud_link.json
msgid "A link to a file or folder in OneCloud for people outside the team."
msgstr "رابط إلى ملف أو مجلد في OneCloud لأشخاص من خارج الفريق."

#. Description of the 'Sent by a Machine' (Check) field in DocType 'Reading'
#: onedesk/one_intake/doctype/reading/reading.json
msgid "A mailing list, a bulk send or an automatic reply."
msgstr "قائمة بريدية أو إرسال جماعي أو رد آلي."

#. Description of the 'Measure' (Data) field in DocType 'Record Head Band'
#: onedesk/one/doctype/record_head_band/record_head_band.json
msgid "A measure a module registered by name. It may say its own label, tone and link."
msgstr "مقياس سجّلته وحدة باسمه. قد يحدد عنوانه ونبرته ورابطه بنفسه."

#. Description of the 'Measure' (Data) field in DocType 'Record Head Indicator'
#: onedesk/one/doctype/record_head_indicator/record_head_indicator.json
msgid "A measure a module registered that says the pill itself, as a label and a colour. Nothing said is no pill."
