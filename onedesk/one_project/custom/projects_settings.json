{
 "custom_fields": [
  {
   "dt": "Projects Settings",
   "fieldname": "one_billing_section",
   "label": "Billing",
   "fieldtype": "Section Break",
   "insert_after": "fetch_timesheet_in_sales_invoice",
   "module": "One Project"
  },
  {
   "dt": "Projects Settings",
   "fieldname": "one_retention",
   "label": "Hold Retention",
   "fieldtype": "Check",
   "insert_after": "one_billing_section",
   "module": "One Project",
   "default": "0"
  },
  {
   "dt": "Projects Settings",
   "fieldname": "one_retention_tax",
   "label": "Tax on Retention",
   "fieldtype": "Select",
   "options": "With the Invoice\nWhen Released",
   "insert_after": "one_retention",
   "module": "One Project",
   "depends_on": "one_retention",
   "description": "Where a new order starts. When Released taxes each invoice on the work less its retention, and the retention when it's released."
  },
  {
   "dt": "Projects Settings",
   "fieldname": "one_time_section",
   "label": "Time",
   "fieldtype": "Section Break",
   "insert_after": "one_retention_tax",
   "module": "One Project"
  },
  {
   "dt": "Projects Settings",
   "fieldname": "one_time_default",
   "label": "Count Time By",
   "fieldtype": "Select",
   "options": "Timesheets\nAttendance on Site\nNot Tracked",
   "default": "Timesheets",
   "insert_after": "one_time_section",
   "module": "One Project",
   "description": "For new projects"
  },
  {
   "dt": "Projects Settings",
   "fieldname": "one_site_activity",
   "label": "Activity for Days on Site",
   "fieldtype": "Link",
   "options": "Activity Type",
   "insert_after": "one_time_default",
   "module": "One Project"
  }
 ],
 "doctype": "Projects Settings",
 "links": [],
 "property_setters": [
  {
   "doctype_or_field": "DocField",
   "doc_type": "Projects Settings",
   "field_name": "ignore_user_time_overlap",
   "property": "description",
   "property_type": "Text",
   "value": "If enabled, a user may log two timesheet rows for the same hours."
  },
  {
   "doctype_or_field": "DocField",
   "doc_type": "Projects Settings",
   "field_name": "ignore_employee_time_overlap",
   "property": "description",
   "property_type": "Text",
   "value": "If enabled, an employee may log two timesheet rows for the same hours, such as a supervisor on two sites at once."
  },
  {
   "doctype_or_field": "DocField",
   "doc_type": "Projects Settings",
   "field_name": "fetch_timesheet_in_sales_invoice",
   "property": "description",
   "property_type": "Text",
   "value": "If enabled, choosing a project on a sales invoice adds its billable timesheets. Invoice Time on a project adds them either way."
  }
 ],
 "sync_on_migrate": 1
}
