{
 "custom_fields": [
  {
   "dt": "Item",
   "fieldname": "one_measured_by",
   "fieldtype": "Select",
   "label": "Sold by Size",
   "options": "No\nPiece\nLength\nArea\nVolume",
   "default": "No",
   "insert_after": "stock_uom",
   "module": "One Inventory",
   "description": "Orders give each piece's size. By length, area or volume the quantity follows from it; by the piece the size only prints."
  },
  {
   "dt": "Item",
   "fieldname": "one_size_uom",
   "fieldtype": "Link",
   "options": "UOM",
   "label": "Size Unit",
   "insert_after": "one_measured_by",
   "depends_on": "eval:doc.one_measured_by && doc.one_measured_by !== \"No\"",
   "module": "One Inventory",
   "description": "What an order's sizes for this item are typed in. Left blank, the workspace's, in Stock Settings."
  }
 ],
 "doctype": "Item",
 "links": [],
 "property_setters": [
  {
   "doc_type": "Item",
   "doctype_or_field": "DocField",
   "property": "in_list_view",
   "property_type": "Check",
   "value": "0",
   "field_name": "is_fixed_asset"
  },
  {
   "doc_type": "Item",
   "doctype_or_field": "DocField",
   "property": "in_standard_filter",
   "property_type": "Check",
   "value": "0",
   "field_name": "has_variants"
  },
  {
   "doc_type": "Item",
   "doctype_or_field": "DocField",
   "property": "in_standard_filter",
   "property_type": "Check",
   "value": "0",
   "field_name": "variant_of"
  }
 ],
 "sync_on_migrate": 1
}
